# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/lexgen

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# RAG Configuration (optional - defaults provided)
# MongoDB Atlas Vector Search index name
VECTOR_INDEX_NAME=template_vector_index

# OpenAI embedding model to use
EMBEDDING_MODEL=text-embedding-3-small

# Number of similar chunks to retrieve for RAG
TOP_K_RETRIEVAL=5

# Debug logging (set to true for verbose logs)
DEBUG=false
